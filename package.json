{
  "name": "thero-taskorder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"import('fs').then((fs) => fs.copyFileSync('dist/index.html', 'dist/404.html'))\" && npm run build:bridge && npm run build:snippet",
    "build:bridge": "vite build --config vite.bridge.config.ts",
    "build:snippet": "node scripts/build-snippet.mjs",
    "build:pages": "npm run build",
    "build:local": "tsc -b && vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/db": "^0.11.3",
    "@tanstack/query-core": "^5.104.1",
    "@tanstack/query-db-collection": "^1.3.4",
    "@tanstack/react-db": "^0.5.1",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^1.50.0",
    "penpal": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "overrides": {
    "@tanstack/db": "$@tanstack/db"
  }
}
